{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "allowImportingTsExtensions": true, "jsx": "react-jsx", "strict": true,
    "isolatedModules": true, "noEmit": true, "skipLibCheck": true, "types": ["vite/client"]
  },
  "include": ["src/renderer", "src/shared", "vite.config.ts"]
}
